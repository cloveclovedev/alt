# Production deployment inputs. DO NOT put real values here or in a committed
# .env. Secrets are injected at deploy time from Bitwarden Secrets Manager:
#
#     bws run -- docker compose -f deploy/prod/compose.yaml up -d --build
#
# Non-secret, environment-selected values may live in a local .env.

# --- PostgreSQL (self-hosted in this stack) ---
POSTGRES_DB=alt
POSTGRES_USER=alt
# POSTGRES_PASSWORD=            (secret) also composes DATABASE_URL

# --- Object storage: Cloudflare R2 (cloveclovedev account) ---
# ALT_OBJECT_STORE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# ALT_OBJECT_STORE_BUCKET=<bucket>
# ALT_OBJECT_STORE_ACCESS_KEY_ID=      (secret)
# ALT_OBJECT_STORE_SECRET_ACCESS_KEY=  (secret)

# --- Application secrets ---
# ALT_OPENROUTER_API_KEY=              (secret)
# ALT_GOOGLE_OAUTH_CLIENT_ID=          (prod OAuth client)
# ALT_GOOGLE_OAUTH_CLIENT_SECRET=      (secret)
# ALT_CALENDAR_TOKEN_ENCRYPTION_KEY=   (secret)
#
# The prod Google OAuth client authorizes the redirect
# https://alt.home.mkuri.dev/settings/calendar/callback (authorized domain
# mkuri.dev). The redirect URL itself is set in compose.yaml, not here.
